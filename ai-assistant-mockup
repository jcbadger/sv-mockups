<!DOCTYPE html>  // this changes nothing!
<html>
<head>
<meta charset="UTF-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
  #bg { display: block; width: 100vw; height: 100vh; object-fit: fill; position: fixed; top: 0; left: 0; z-index: 0; }

  .fab {
    position: fixed; bottom: 24px; left: 10px; z-index: 100;
    width: 56px; height: 56px; border-radius: 50%; border: none; cursor: pointer;
    background: linear-gradient(135deg, #b73eb4 0%, #4B55D6 100%);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 3px 14px rgba(183,62,180,0.5); transition: transform 0.15s;
  }
  .fab:hover { transform: scale(1.08); }
  .fab:hover .fab-tooltip { opacity: 1; pointer-events: auto; }
  .fab-tooltip {
    position: absolute; left: 64px; bottom: 14px;
    background: #111; color: #fff; font-size: 12px; font-weight: 500;
    padding: 5px 10px; border-radius: 6px; white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity 0.15s;
  }

  .drawer {
    position: fixed; top: 0; left: 0; height: 100vh; width: 375px;
    background: #fff; border-right: 1px solid #e0e0e0;
    display: flex; flex-direction: column;
    transform: translateX(-100%); visibility: hidden;
    transition: transform 0.25s ease, visibility 0s linear 0.25s;
    z-index: 200; box-shadow: 4px 0 20px rgba(0,0,0,0.12);
  }
  .drawer.open { transform: translateX(0); visibility: visible; transition: transform 0.25s ease, visibility 0s linear 0s; }
  .drawer.docked-right { left: auto; right: 0; border-right: none; border-left: 1px solid #e0e0e0; transform: translateX(100%); box-shadow: -4px 0 20px rgba(0,0,0,0.12); }
  .drawer.docked-right.open { transform: translateX(0); }
  .drawer.maximized { width: 100vw !important; }

  .resize-handle { position: absolute; top: 0; right: -4px; width: 8px; height: 100%; cursor: ew-resize; z-index: 300; }
  .drawer.docked-right .resize-handle { right: auto; left: -4px; }
  .drawer.maximized .resize-handle { display: none; }

  .drawer-header { padding: 10px 12px; border-bottom: 1px solid #eee; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; position: relative; background: #fff; z-index: 10; }
  .drawer-title {
    font-size: 13px; font-weight: 600;
    background: linear-gradient(135deg, #b73eb4, #4B55D6);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    display: flex; align-items: center; gap: 7px;
  }
  .header-actions { display: flex; align-items: center; gap: 3px; }
  .hbtn { background: none; border: 1px solid #ddd; border-radius: 5px; width: 26px; height: 26px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.1s; flex-shrink: 0; }
  .hbtn:hover { background: #f5f5f5; }
  .hbtn.active { border-color: #b73eb4; background: rgba(183,62,180,0.08); }

  .privacy-banner { padding: 7px 14px; background: #f9f6ff; border-bottom: 1px solid #ede8fb; flex-shrink: 0; text-align: center; position: relative; z-index: 10; }
  .privacy-banner-text { font-size: 11px; color: #7a6fa0; line-height: 1.4; }

  .msgs-wrap { flex: 1; position: relative; overflow: hidden; }
  .watermark-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; }
  .msgs { position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; z-index: 1; }

  .msg-wrap-ai { align-self: flex-start; max-width: 88%; }
  .msg-wrap-user { align-self: flex-end; max-width: 88%; }
  .msg-label { font-size: 10px; color: #999; margin-bottom: 3px; }
  .msg-label-right { text-align: right; }
  .bubble-ai { background: #f5f5f7; border-radius: 10px 10px 10px 2px; padding: 9px 12px; font-size: 13px; line-height: 1.5; color: #222; user-select: none; -webkit-user-select: none; }
  .bubble-user { background: linear-gradient(135deg, #b73eb4, #4B55D6); border-radius: 10px 10px 2px 10px; padding: 9px 12px; font-size: 13px; line-height: 1.5; color: #fff; user-select: none; -webkit-user-select: none; }

  .input-area { border-top: 1px solid #eee; flex-shrink: 0; position: relative; z-index: 10; background: #fff; }
  .input-row { padding: 10px 12px 6px; display: flex; gap: 7px; align-items: center; }
  .chat-inp { flex: 1; border: 1px solid #ddd; border-radius: 8px; padding: 8px 10px; font-size: 13px; outline: none; font-family: inherit; }
  .chat-inp:focus { border-color: #b73eb4; }
  .send-btn { background: linear-gradient(135deg, #b73eb4, #4B55D6); border: none; border-radius: 8px; width: 34px; height: 34px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

  .input-toolbar { padding: 0 12px 6px; display: flex; align-items: center; gap: 6px; }
  .round-btn { width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid #ccc; background: none; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #666; transition: border-color 0.15s, color 0.15s; position: relative; flex-shrink: 0; }
  .round-btn:hover { border-color: #b73eb4; color: #b73eb4; }
  .round-btn.active { border-color: #b73eb4; color: #b73eb4; background: rgba(183,62,180,0.06); }

  .dropdown-menu { position: absolute; bottom: 34px; left: 0; background: #fff; border: 1px solid #e0e0e0; border-radius: 10px; box-shadow: 0 4px 16px rgba(0,0,0,0.12); width: 220px; overflow: hidden; display: none; z-index: 50; }
  .dropdown-menu.open { display: block; }
  .dropdown-header { padding: 8px 14px; font-size: 11px; color: #999; font-weight: 500; border-bottom: 1px solid #f0f0f0; }
  .dropdown-item { padding: 10px 14px; font-size: 13px; color: #222; cursor: pointer; display: flex; align-items: center; gap: 8px; }
  .dropdown-item:hover { background: #f5f5f7; }
  .dropdown-item.new-chat { color: #b73eb4; font-weight: 500; border-bottom: 1px solid #f0f0f0; }
  .dropdown-item-date { font-size: 11px; color: #999; margin-left: auto; }
  .disclaimer { padding: 5px 14px 8px; font-size: 11px; color: #aaa; text-align: center; line-height: 1.4; }
</style>
</head>
<body>

<img id="bg" src="1774917406174_image.png" alt="" />

<button class="fab" id="fab" onclick="openDrawer()">
  <div class="fab-tooltip">AI Assistant</div>
  <svg width="36" height="36" viewBox="0 0 24 26" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 6C2 4.9 2.9 4 4 4h16c1.1 0 2 .9 2 2v11c0 1.1-.9 2-2 2H8l-6 4V6Z" fill="white" opacity="0.93"></path>
    <g transform="scale(0.52) translate(13 10.5)">
      <path stroke="url(#sg)" stroke-width="1.1" stroke-linejoin="round" d="m13 4 1.753 4.444c.188.477.282.715.426.916q.192.269.461.461c.201.144.439.238.916.426L21 12l-4.444 1.753c-.477.188-.715.282-.916.426a2 2 0 0 0-.461.461c-.144.201-.238.439-.426.916L13 20l-1.753-4.444c-.188-.477-.282-.715-.426-.916a2 2 0 0 0-.461-.461c-.201-.144-.439-.238-.916-.426L5 12l4.444-1.753c.477-.188.715-.282.916-.426q.269-.192.461-.461c.144-.201.238-.439.426-.916z"></path>
      <path stroke="url(#sg)" stroke-width=".75" d="m5.989 4.279.376.953c.04.102.06.153.091.196q.04.057.099.099a1 1 0 0 0 .196.091l.953.376-.953.376c-.102.04-.153.06-.196.091a.4.4 0 0 0-.099.099 1 1 0 0 0-.091.196l-.376.953-.376-.953a1 1 0 0 0-.091-.196.4.4 0 0 0-.099-.099 1 1 0 0 0-.196-.091l-.953-.376.953-.376a1 1 0 0 0 .196-.091.5.5 0 0 0 .099-.099 1 1 0 0 0 .091-.196zM4.986 16.308l.376.953c.04.102.06.153.091.196q.04.057.099.099a1 1 0 0 0 .196.091l.953.376-.953.376c-.102.04-.153.06-.196.091a.4.4 0 0 0-.099.099 1 1 0 0 0-.091.196l-.376.953-.376-.953a1 1 0 0 0-.091-.196.4.4 0 0 0-.099-.099 1 1 0 0 0-.196-.091l-.953-.376.953-.376c.102-.04.153-.06.196-.091a.5.5 0 0 0 .099-.099 1 1 0 0 0 .091-.196z"></path>
    </g>
    <defs>
      <linearGradient id="sg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="
#b73eb4"></stop>
        <stop offset="100%" stop-color="
#4B55D6"></stop>
      </linearGradient>
    </defs>
  </svg>
</button>

<div class="drawer" id="drawer">
  <div class="resize-handle" id="resizeHandle"></div>

  <div class="drawer-header">
    <div class="drawer-title">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
        <path d="M2 5C2 3.9 2.9 3 4 3h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H8l-6 4V5Z" fill="url(#hg)" opacity="0.9"/>
        <defs><linearGradient id="hg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#b73eb4"/><stop offset="100%" stop-color="#4B55D6"/></linearGradient></defs>
      </svg>
      AI Assistant
    </div>
    <div class="header-actions">
      <button class="hbtn active" id="btnLeft" onclick="dockLeft()" title="Dock left">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><rect x="1" y="1" width="4" height="10" rx="1" fill="#666"/><rect x="6" y="3" width="5" height="6" rx="1" fill="#ccc"/></svg>
      </button>
      <button class="hbtn" id="btnRight" onclick="dockRight()" title="Dock right">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><rect x="7" y="1" width="4" height="10" rx="1" fill="#666"/><rect x="1" y="3" width="5" height="6" rx="1" fill="#ccc"/></svg>
      </button>
      <button class="hbtn" id="btnMax" onclick="toggleMax()" title="Maximize">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><rect x="1" y="1" width="10" height="10" rx="1" stroke="#666" stroke-width="1.2" fill="none"/><path d="M4 1.5v9M8 1.5v9" stroke="#ccc" stroke-width="0.8"/></svg>
      </button>
      <button class="hbtn" onclick="closeDrawer()" title="Close">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 1l8 8M9 1L1 9" stroke="#666" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div class="privacy-banner">
    <span class="privacy-banner-text">Chats are private and not visible to anyone else.</span>
  </div>

  <div class="msgs-wrap" id="msgsWrap">
    <canvas class="watermark-canvas" id="wmCanvas"></canvas>
    <div class="msgs" id="msgs">
      <div class="msg-wrap-ai">
        <div class="msg-label">AI Assistant</div>
        <div class="bubble-ai">Hi John! Ask me anything about the documents in the "Project Optima" ShareVault.</div>
      </div>
    </div>
  </div>

  <div class="input-area">
    <div class="input-row">
      <input class="chat-inp" id="inp" placeholder="Ask anything about this ShareVault…" onkeydown="if(event.key==='Enter')send()"/>
      <button class="send-btn" onclick="send()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 12V2M2 7l5-5 5 5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="input-toolbar">
      <button class="round-btn" id="plusBtn" onclick="toggleMenu('plusMenu',event)" title="More options">
        <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <div class="dropdown-menu" id="plusMenu">
          <div class="dropdown-item new-chat" onclick="newChat()">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 2v12M2 8h12" stroke="#b73eb4" stroke-width="1.4" stroke-linecap="round"/></svg>
            New chat
          </div>
          <div class="dropdown-item" onclick="uploadFile()">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 10v2.5c0 .8.7 1.5 1.5 1.5h7c.8 0 1.5-.7 1.5-1.5V10M8 2v8M5 5l3-3 3 3" stroke="#666" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Upload file <span style="font-size:11px;color:#999;margin-left:3px;">(private)</span>
          </div>
        </div>
      </button>
      <button class="round-btn" id="histBtn" onclick="toggleMenu('histMenu',event)" title="Chat history">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.2"/><path d="M8 5v3.5l2 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        <div class="dropdown-menu" id="histMenu" style="width:240px;">
          <div class="dropdown-item new-chat" onclick="newChat()">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 2v12M2 8h12" stroke="#b73eb4" stroke-width="1.4" stroke-linecap="round"/></svg>
            New chat
          </div>
          <div class="dropdown-header">Recent chats</div>
          <div class="dropdown-item" onclick="loadConvo('What are the key terms in the NDA?')">Key terms in the NDA<span class="dropdown-item-date">Today</span></div>
          <div class="dropdown-item" onclick="loadConvo('Summarize the financials')">Financials summary<span class="dropdown-item-date">Yesterday</span></div>
          <div class="dropdown-item" onclick="loadConvo('How do I invite a new user?')">How to invite a new user<span class="dropdown-item-date">Mar 27</span></div>
        </div>
      </button>
    </div>
    <div class="disclaimer">AI Assistant can make mistakes. Please double-check responses.</div>
  </div>
</div>

<script>
  var maximized = false;
  var prevDockState = 'left';

  function drawWatermark() {
    var wrap = document.getElementById('msgsWrap');
    var canvas = document.getElementById('wmCanvas');
    var W = wrap.offsetWidth;
    var H = wrap.offsetHeight;
    if (!W || !H) return;
    canvas.width = W;
    canvas.height = H;
    var ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, W, H);

    var lines = [
      { text: 'STRICTLY CONFIDENTIAL', bold: true },
      { text: 'CoreX Corporation', bold: false },
      { text: 'Opened by jsmith@corex.com', bold: false },
      { text: 'on Mar 30, 2026 at 5:31:35 PM', bold: false },
      { text: 'IP: 198.51.42.17', bold: false }
    ];

    var naturalAngle = Math.atan2(H, W);
    var maxAngle = 55 * Math.PI / 180;
    var angleRad = Math.min(naturalAngle, maxAngle);
    var cosA = Math.cos(angleRad);
    var sinA = Math.sin(angleRad);
    var lineSpacing = 1.2;
    var nLines = lines.length;
    var margin = 0.96;

    var testSize = 100;
    var maxTextW = 0;
    lines.forEach(function(l) {
      ctx.font = (l.bold ? 'bold ' : '') + testSize + 'px Arial';
      var m = ctx.measureText(l.text).width;
      if (m > maxTextW) maxTextW = m;
    });

    var blockH100 = testSize * lineSpacing * nLines;

    var scaleForW = (W * margin) / (maxTextW * cosA + blockH100 * sinA);
    var scaleForH = (H * margin) / (maxTextW * sinA + blockH100 * cosA);
    var scale = Math.min(scaleForW, scaleForH);

    var fontSize = Math.max(8, Math.floor(testSize * scale));
    var lineH = fontSize * lineSpacing;
    var blockH = lineH * nLines;
    var scaledTextW = maxTextW * (fontSize / testSize);

	var tileVertH = (scaledTextW * sinA + blockH * cosA) * 0.85;

    var numTiles = Math.max(1, Math.floor(H / tileVertH));

    var totalUsed = (numTiles - 1) * tileVertH;
    var startY = (H - totalUsed) / 2;

    for (var t = 0; t < numTiles; t++) {
      var cy = startY + t * tileVertH;
      ctx.save();
      ctx.translate(W / 2, cy);
      ctx.rotate(-angleRad);
      ctx.globalAlpha = 0.15;
      ctx.fillStyle = '#4B55D6';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      lines.forEach(function(line, i) {
        ctx.font = (line.bold ? 'bold ' : '') + fontSize + 'px Arial';
        ctx.fillText(line.text, 0, (i - (nLines - 1) / 2) * lineH);
      });
      ctx.restore();
    }
  }

  var resizeTimer;
  var ro = new ResizeObserver(function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(drawWatermark, 30);
  });
  ro.observe(document.getElementById('msgsWrap'));

  function openDrawer() {
    document.getElementById('drawer').classList.add('open');
    document.getElementById('fab').style.display = 'none';
    setTimeout(drawWatermark, 50);
  }
  function closeDrawer() {
    var d = document.getElementById('drawer');
    d.classList.remove('open');
    document.getElementById('fab').style.display = 'flex';
    if (maximized) { d.classList.remove('maximized'); d.style.width = ''; maximized = false; document.getElementById('btnMax').classList.remove('active'); restoreDockHighlight(); }
    closeAllMenus();
  }
  function dockLeft() {
    var d = document.getElementById('drawer');
    if (maximized) { d.classList.remove('maximized'); d.style.width = ''; maximized = false; document.getElementById('btnMax').classList.remove('active'); }
    d.classList.remove('docked-right'); d.style.width = '';
    prevDockState = 'left';
    document.getElementById('btnLeft').classList.add('active');
    document.getElementById('btnRight').classList.remove('active');
    setTimeout(drawWatermark, 50);
  }
  function dockRight() {
    var d = document.getElementById('drawer');
    if (maximized) { d.classList.remove('maximized'); d.style.width = ''; maximized = false; document.getElementById('btnMax').classList.remove('active'); }
    d.classList.add('docked-right'); d.style.width = '';
    prevDockState = 'right';
    document.getElementById('btnRight').classList.add('active');
    document.getElementById('btnLeft').classList.remove('active');
    setTimeout(drawWatermark, 50);
  }
  function toggleMax() {
    var d = document.getElementById('drawer');
    maximized = !maximized;
    if (maximized) {
      d.classList.add('maximized');
      document.getElementById('btnMax').classList.add('active');
      document.getElementById('btnLeft').classList.remove('active');
      document.getElementById('btnRight').classList.remove('active');
    } else {
      d.classList.remove('maximized'); d.style.width = '';
      document.getElementById('btnMax').classList.remove('active');
      restoreDockHighlight();
    }
    setTimeout(drawWatermark, 50);
  }
  function restoreDockHighlight() {
    document.getElementById('btnLeft').classList.toggle('active', prevDockState === 'left');
    document.getElementById('btnRight').classList.toggle('active', prevDockState === 'right');
  }
  function closeAllMenus() {
    ['plusMenu','histMenu'].forEach(function(id){ document.getElementById(id).classList.remove('open'); });
    ['plusBtn','histBtn'].forEach(function(id){ document.getElementById(id).classList.remove('active'); });
  }
  function toggleMenu(id, e) {
    e.stopPropagation();
    var isOpen = document.getElementById(id).classList.contains('open');
    closeAllMenus();
    if (!isOpen) {
      document.getElementById(id).classList.add('open');
      document.getElementById(id === 'plusMenu' ? 'plusBtn' : 'histBtn').classList.add('active');
    }
  }
  document.addEventListener('click', closeAllMenus);

  function newChat() {
    document.getElementById('msgs').innerHTML = '<div class="msg-wrap-ai"><div class="msg-label">AI Assistant</div><div class="bubble-ai">Hi John! Ask me anything about the documents in the "Project Optima" ShareVault.</div></div>';
    closeAllMenus();
  }
  function uploadFile() { alert('File upload coming soon.'); closeAllMenus(); }
  function loadConvo(text) {
    newChat();
    setTimeout(function() {
      var msgs = document.getElementById('msgs');
      var u = document.createElement('div'); u.className = 'msg-wrap-user';
      u.innerHTML = '<div class="msg-label msg-label-right">You</div><div class="bubble-user">' + text + '</div>';
      msgs.appendChild(u);
      var a = document.createElement('div'); a.className = 'msg-wrap-ai';
      a.innerHTML = '<div class="msg-label">AI Assistant</div><div class="bubble-ai">Here is what I found about that…</div>';
      msgs.appendChild(a); msgs.scrollTop = msgs.scrollHeight;
    }, 100);
    closeAllMenus();
  }
  function send() {
    var inp = document.getElementById('inp');
    var text = inp.value.trim(); if (!text) return;
    var msgs = document.getElementById('msgs');
    var u = document.createElement('div'); u.className = 'msg-wrap-user';
    u.innerHTML = '<div class="msg-label msg-label-right">You</div><div class="bubble-user">' + text + '</div>';
    msgs.appendChild(u); inp.value = ''; msgs.scrollTop = msgs.scrollHeight;
    setTimeout(function() {
      var a = document.createElement('div'); a.className = 'msg-wrap-ai';
      a.innerHTML = '<div class="msg-label">AI Assistant</div><div class="bubble-ai">Searching the vault…</div>';
      msgs.appendChild(a); msgs.scrollTop = msgs.scrollHeight;
    }, 600);
  }
  document.getElementById('msgs').addEventListener('copy', function(e) { e.preventDefault(); });

  var isResizing = false, startX, startW;
  document.getElementById('resizeHandle').addEventListener('mousedown', function(e) {
    isResizing = true; startX = e.clientX; startW = document.getElementById('drawer').offsetWidth;
    document.body.style.cursor = 'ew-resize'; document.body.style.userSelect = 'none';
  });
  document.addEventListener('mousemove', function(e) {
    if (!isResizing || maximized) return;
    var d = document.getElementById('drawer');
    var dx = d.classList.contains('docked-right') ? startX - e.clientX : e.clientX - startX;
    d.style.width = Math.max(280, Math.min(window.innerWidth * 0.8, startW + dx)) + 'px';
    drawWatermark();
  });
  document.addEventListener('mouseup', function() {
    if (isResizing) { isResizing = false; document.body.style.cursor = ''; document.body.style.userSelect = ''; }
  });
</script>
</body>
</html>
